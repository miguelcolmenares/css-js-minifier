.vscode/**
.vscode-test/**
out/**
coverage/**
node_modules/**
# The `lightningcss-*` and `@oxc-minify/**` globs already cover the musl bindings
# (`lightningcss-linux-*-musl`, `@oxc-minify/binding-linux-*-musl`) that the
# `alpine-*` targets ship, so no extra entries are needed for them.
!node_modules/lightningcss/**
!node_modules/lightningcss-*/**
!node_modules/oxc-minify/**
!node_modules/@oxc-minify/**
!node_modules/detect-libc/**
src/**
.gitignore
.yarnrc
webpack.config.js
vsc-extension-quickstart.md
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts
**/.vscode-test.*
.github/**
docs/**
scripts/**
images/*.gif
site/**
