{
	"name": "css-js-minifier",
	"displayName": "JS & CSS Minifier Tool and Compressor",
	"description": "Minify CSS and JS locally within Visual Studio Code. CSS uses LightningCSS and JS uses oxc-minify — both Rust-based, fully offline, with no API dependencies. Full support for modern CSS features like @starting-style. Supports 7 languages: English, Spanish, French, German, Portuguese, Japanese, and Chinese.",
	"version": "1.3.1",
	"publisher": "miguel-colmenares",
	"l10n": "./l10n",
	"sponsor": {
		"url": "https://github.com/sponsors/miguelcolmenares"
	},
	"icon": "images/icon.png",
	"license": "MIT",
	"author": {
		"name": "Miguel Colmenares",
		"email": "me@miguelcolmenares.com"
	},
	"galleryBanner": {
		"color": "#232323",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.116.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"minify",
		"minifier",
		"formatter",
		"format",
		"compressor",
		"compress",
		"css",
		"javascript",
		"js",
		"i18n",
		"internationalization",
		"multilingual",
		"localization"
	],
	"activationEvents": [
		"onSaveTextDocument"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "extension.minify",
				"title": "%commands.extension.minify.title%"
			},
			{
				"command": "extension.minifyInNewFile",
				"title": "%commands.extension.minifyInNewFile.title%"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "extension.minify",
					"when": "resourceLangId == css || resourceLangId == javascript",
					"group": "_CSS&JSMinifier"
				},
				{
					"command": "extension.minifyInNewFile",
					"when": "resourceLangId == css || resourceLangId == javascript",
					"group": "_CSS&JSMinifier"
				}
			],
			"explorer/context": [
				{
					"command": "extension.minify",
					"when": "resourceLangId == css || resourceLangId == javascript",
					"group": "_CSS&JSMinifier"
				},
				{
					"command": "extension.minifyInNewFile",
					"when": "resourceLangId == css || resourceLangId == javascript",
					"group": "_CSS&JSMinifier"
				}
			]
		},
		"configuration": {
			"type": "object",
			"title": "%configuration.title%",
			"properties": {
				"css-js-minifier.minifyOnSave": {
					"type": "boolean",
					"default": false,
					"description": "%configuration.minifyOnSave%"
				},
				"css-js-minifier.minifyInNewFile": {
					"type": "boolean",
					"default": false,
					"description": "%configuration.minifyInNewFile%"
				},
				"css-js-minifier.minifiedNewFilePrefix": {
					"type": "string",
					"default": ".min",
					"enum": [
						".min",
						"-min",
						".compressed",
						"-compressed",
						".minified",
						"-minified"
					],
					"enumDescriptions": [
						"%configuration.minifiedNewFilePrefix.enumDescriptions.1%",
						"%configuration.minifiedNewFilePrefix.enumDescriptions.2%",
						"%configuration.minifiedNewFilePrefix.enumDescriptions.3%",
						"%configuration.minifiedNewFilePrefix.enumDescriptions.4%",
						"%configuration.minifiedNewFilePrefix.enumDescriptions.5%",
						"%configuration.minifiedNewFilePrefix.enumDescriptions.6%"
					],
					"description": "%configuration.minifiedNewFilePrefix%"
				},
				"css-js-minifier.autoOpenNewFile": {
					"type": "boolean",
					"default": true,
					"description": "%configuration.autoOpenNewFile%"
				},
				"css-js-minifier.showSizeReduction": {
					"type": "boolean",
					"default": true,
					"description": "%configuration.showSizeReduction%"
				}
			}
		},
		"keybindings": [
			{
				"command": "extension.minify",
				"key": "alt+ctrl+m",
				"mac": "alt+ctrl+m",
				"linux": "alt+ctrl+m",
				"win": "alt+ctrl+m",
				"when": "editorTextFocus && !editorReadonly"
			},
			{
				"command": "extension.minifyInNewFile",
				"key": "alt+ctrl+n",
				"mac": "alt+ctrl+n",
				"linux": "alt+ctrl+n",
				"win": "alt+ctrl+n",
				"when": "editorTextFocus && !editorReadonly"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"compile-tests": "tsc -p . --outDir out",
		"copy-fixtures": "cp -r ./src/test/fixtures ./out/test/fixtures/",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint && npm run copy-fixtures",
		"lint": "eslint \"src/**/*.ts\"",
		"lint:fix": "eslint \"src/**/*.ts\" --fix",
		"format": "prettier --write \"src/**/*.ts\" \"*.{json,md,cjs,mjs}\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,cjs,mjs}\"",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.6",
		"@types/node": "^25.6.0",
		"@types/sinon": "^21.0.1",
		"@types/vscode": "^1.118.0",
		"@typescript-eslint/eslint-plugin": "^8.59.2",
		"@typescript-eslint/parser": "^8.58.0",
		"@vscode/l10n-dev": "^0.0.35",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"mocha": "^11.7.5",
		"prettier": "^3.8.3",
		"sinon": "^21.1.2",
		"ts-loader": "^9.5.4",
		"typescript": "^6.0.3",
		"webpack": "^5.106.2",
		"webpack-cli": "^7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/miguelcolmenares/css-js-minifier.git"
	},
	"bugs": {
		"url": "https://github.com/miguelcolmenares/css-js-minifier/issues"
	},
	"homepage": "https://github.com/miguelcolmenares/css-js-minifier#readme",
	"overrides": {
		"serialize-javascript": "^7.0.3",
		"@sinonjs/fake-timers": "15.1.1"
	},
	"dependencies": {
		"lightningcss": "^1.32.0",
		"oxc-minify": "^0.129.0"
	}
}
