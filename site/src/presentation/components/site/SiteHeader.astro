---
import { Box, GitBranch } from "lucide-react";
import { buttonVariants } from "../ui/button";
import { MobileMenu } from "./MobileMenu";

interface Props {
  name: string;
  home: string;
  links: readonly { label: string; href: string }[];
  repositoryUrl?: string;
  action?: { label: string; href: string };
  /** Pathname of the page being shown, to mark the current link. */
  current?: string;
}
const { name, home, links, repositoryUrl, action, current } = Astro.props;
const isCurrent = (href: string) => Boolean(current) && (current === href || (href !== home && current!.startsWith(href)));
---

<header class="sticky top-0 z-40 h-(--sk-layout-nav-h) border-b border-border bg-background/70 backdrop-blur-md">
  <div class="mx-auto flex h-full max-w-site items-center gap-6 px-5">
    <a href={home} class="inline-flex items-center gap-2 font-semibold tracking-tight text-fg-bright">
      <Box className="size-5 text-brand" aria-hidden="true" />
      {name}
    </a>
    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
            class="rounded-md px-3 py-1.5 text-sm text-fg-muted transition-colors hover:text-fg-bright aria-[current=page]:text-fg-bright"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-2">
      {
        repositoryUrl && (
          <a
            href={repositoryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm text-fg-muted hover:text-fg-bright sm:inline-flex"
          >
            <GitBranch className="size-4" aria-hidden="true" />
            GitHub
          </a>
        )
      }
      {
        action && (
          <a href={action.href} class={`${buttonVariants({ size: "sm" })} hidden md:inline-flex`}>
            {action.label}
          </a>
        )
      }
      <MobileMenu links={links} action={action} client:load />
    </div>
  </div>
</header>
